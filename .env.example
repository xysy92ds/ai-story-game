# Neon 数据库连接串（Neon 控制台 → Database → Connect → 复制 Connection string）
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# 用于加密房主填写的 API Key。生产环境请改为随机长字符串（openssl rand -hex 32）
APP_SECRET=please-change-me-to-a-long-random-secret

# 可选：全局兜底 API Key（房主创建房间时留空则使用对应服务商的该变量）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# 可选：Cron 清理接口鉴权（配置 Vercel Cron 时使用）
CRON_SECRET=